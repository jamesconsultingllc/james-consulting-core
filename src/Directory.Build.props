<Project>
    <PropertyGroup>
        <!-- Solution-wide metadata. Per-project metadata (PackageId, Description, etc.)
             still lives in each .csproj. -->
        <Authors>Rudy James</Authors>
        <Company>James Consulting LLC</Company>
        <Copyright>Copyright (c) 2020 - 2026 James Consulting LLC. All Rights Reserved.</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/jamesconsultingllc/james-consulting-core</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Build behavior -->
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!--
            Only enable on CI. Locally this rewrites source paths and disables
            timestamp-based optimizations, slowing inner-loop builds and
            confusing IDE debugging. GitHub Actions sets CI=true automatically.
        -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pin a specific Nerdbank.GitVersioning version; update when you choose -->
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all"/>
        <!-- Optional: SourceLink for better debugging and provenance -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>
</Project>