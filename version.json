{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/master/src/Nerdbank.GitVersioning/version.schema.json",
  "version": "2.0.0",
  "assemblyVersion": {
    "precision": "major"
  },
  "publicReleaseRefSpec": [
    "^refs/heads/master$",
    "^refs/heads/release/.*$",
    "^refs/heads/hotfix/.*$",
    "^refs/tags/v\\d+\\.\\d+\\.\\d+$"
  ],
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  },
  "nugetPackageVersion": {
    "semVer": 2
  }
}
