{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/master/src/Nerdbank.GitVersioning/version.schema.json",
  "version": "2.0.0-rc.{height}",
  "assemblyVersion": {
    "precision": "major"
  },
  "publicReleaseRefSpec": [
    "^refs/heads/master$",
    "^refs/heads/release/.*$",
    "^refs/heads/hotfix/.*$"
  ],
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  },
  "nugetPackageVersion": {
    "semVer1NumericIdentifierPadding": 0
  }
}
